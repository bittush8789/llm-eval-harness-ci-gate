# ==============================================================================
# AI Evaluation & Regression Testing Platform - Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Database Connection (PostgreSQL)
# Local execution: postgresql://postgres:postgres@localhost:5432/ai_evaluation
# Docker Compose: postgresql://postgres:postgres@postgres:5432/ai_evaluation
# SQLite offline fallback: sqlite:///./ai_evaluation.db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_evaluation
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_evaluation
POSTGRES_PORT=5432

# Google Gemini API Credentials
GOOGLE_API_KEY=your_gemini_api_key_here

# Application Model Configuration (Target under test)
APP_LLM_MODEL=gemini-3.8-flash
APP_LLM_TEMPERATURE=0.0
APP_PROMPT_VERSION=v1.0.0
PROMPT_FILE_PATH=app/prompts/system_prompt.txt

# Evaluator Judge Model Configuration (Separately configured from application model)
EVALUATOR_LLM_MODEL=gemini-3.8-pro
EVALUATOR_LLM_TEMPERATURE=0.0
EVALUATION_OFFLINE_MODE=false
EVALUATION_THRESHOLDS_FILE=evaluation/thresholds.yaml
DEFAULT_DATASET_VERSION=v1
EVALUATION_MAX_RETRIES=2
EVALUATION_TIMEOUT_SECONDS=30

# Optional LangSmith Tracing & Experiment Tracking (Disabled by default)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_PROJECT=ai-evaluation-regression-platform
